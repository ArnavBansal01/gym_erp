# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build & outputs
/.next/
/out/
/build
/dist

# Environment variables & secrets (never commit secrets)
.env
.env.*
.env*.local
!.env.example
*.pem
*.key
serviceAccountKey.json
firebase-adminsdk*.json

# Testing & Playwright
/coverage/
/test-results/
playwright-report/
docs/playwright-report/
/blob-report/
/playwright/.cache/

# Debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project

# Backups & temporary files
/backup/
*.bak
*.tmp
*.swp
